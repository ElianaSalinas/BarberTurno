<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberTurno.Controls.BrandBar">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,0" HeightRequest="56">
        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17" StrokeThickness="0"
                Background="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkDarkCard}}">
            <Image Source="icon_scissors_gold.svg" WidthRequest="18" HeightRequest="18" />
        </Border>
        <Label Grid.Column="1" VerticalOptions="Center" FontFamily="OpenSansSemibold" FontSize="18"
               TextColor="{AppThemeBinding Light={StaticResource M10LightText}, Dark={StaticResource M10DarkText}}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Barber" />
                    <Span Text="Turno" TextColor="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource M10LightBorder}, Dark={StaticResource M10DarkBorder}}"
                Background="{AppThemeBinding Light={StaticResource M10LightSurface}, Dark={StaticResource M10DarkSurface}}">
            <Image Source="icon_bell.svg" WidthRequest="20" HeightRequest="20" />
        </Border>
    </Grid>
</ContentView>
