<?xml version="1.0" encoding="utf-8" ?>
<!--
    EstadoBanner: indicador compacto de estado para pantallas que ya tienen su propio contenido
    (cabecera, listas con vacío propio). Muestra solo dos de los cuatro estados:
      · Cargando → rueda + texto
      · Error    → mensaje + botón "Reintentar" (si hay comando)
    Vacío y Con datos no muestran nada: los resuelve la propia pantalla.
    Para pantallas que se reemplazan por completo según el estado se usa StateView.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberTurno.Controls.EstadoBanner">
    <VerticalStackLayout x:Name="Raiz" IsVisible="False" Spacing="8">

        <HorizontalStackLayout x:Name="PanelCarga" IsVisible="False" Spacing="10" HorizontalOptions="Center">
            <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20"
                               Color="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />
            <Label x:Name="TextoCarga" Text="Cargando…" VerticalOptions="Center" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource M10LightMutedText}, Dark={StaticResource M10DarkMutedText}}" />
        </HorizontalStackLayout>

        <Border x:Name="PanelError" IsVisible="False" Style="{StaticResource BtCard}" Padding="16">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="TextoError" FontSize="13" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
                <Button x:Name="BotonReintentar" Text="Reintentar" IsVisible="False"
                        Style="{StaticResource BtGoldButton}" HeightRequest="40" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
