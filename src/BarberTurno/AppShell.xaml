<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BarberTurno.Views"
       x:Class="BarberTurno.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarHasShadow="False"
       Shell.BackgroundColor="{AppThemeBinding Light=#F8F7F3, Dark=#151610}"
       Shell.ForegroundColor="{AppThemeBinding Light=#18202D, Dark=#F7F4EE}"
       Shell.TitleColor="{AppThemeBinding Light=#18202D, Dark=#F7F4EE}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#20211A}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light=#9C7429, Dark=#D8AD4A}"
       Shell.TabBarTitleColor="{AppThemeBinding Light=#9C7429, Dark=#D8AD4A}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light=#AAA69E, Dark=#8C877E}">

    <!-- Pantalla de Login inicial de la aplicación -->
    <TabBar Route="barbero">
        <ShellContent Title="Agenda"
                      Route="agenda"
                      ContentTemplate="{DataTemplate views:AgendaDiaPage}" />
        <ShellContent Title="Perfil"
                      Route="perfilbarbero"
                      ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>
    <!-- CLIENTE -->
    <TabBar Route="cliente">
        <ShellContent Title="Inicio" Icon="tab_home.svg" Route="inicio"
                      ContentTemplate="{DataTemplate views:InicioPage}" />
        <ShellContent Title="Mis turnos" Icon="tab_calendar.svg" Route="miscitas"
                      ContentTemplate="{DataTemplate views:MisCitasPage}" />
        <ShellContent Title="Reservar" Icon="tab_plus.svg" Route="barberos"
                      ContentTemplate="{DataTemplate views:BarberosPage}" />
        <ShellContent Title="Servicios" Icon="tab_scissors.svg" Route="catalogo"
                      ContentTemplate="{DataTemplate views:CatalogoPage}" />
        <ShellContent Title="Perfil" Icon="tab_user.svg" Route="perfilcliente"
                      ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>

    <!-- BARBERO -->
    <TabBar Route="barbero">
        <ShellContent Title="Mi agenda" Icon="tab_home.svg" Route="agenda"
                      ContentTemplate="{DataTemplate views:AgendaDiaPage}" />
        <ShellContent Title="Perfil" Icon="tab_user.svg" Route="perfilbarbero"
                      ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>
</Shell>
