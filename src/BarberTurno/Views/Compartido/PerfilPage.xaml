<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Style="{StaticResource M10Page}"
             Title="Perfil">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <controls:StateView State="{Binding State}" ErrorText="{Binding MensajeError}" RetryCommand="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24,28,24,32" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="TU CUENTA" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                    <Label Text="Perfil" Style="{StaticResource BtTitle}" />
                    <Label Text="Tu estilo, tus preferencias, siempre contigo." Style="{StaticResource BtMuted}" />
                </VerticalStackLayout>

                <!-- Tarjeta de usuario -->
                <Border Style="{StaticResource BtDarkCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}">
                            <Label Text="{Binding Inicial}" FontFamily="OpenSansSemibold" FontSize="26"
                                   TextColor="#1B1B17" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="White" />
                            <Label Text="{Binding RolTexto}" FontSize="12" CharacterSpacing="1" Style="{StaticResource BtGold}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Tema -->
                <Border Style="{StaticResource BtCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Tema oscuro" Style="{StaticResource BtH2}" />
                            <Label Text="Cambia la apariencia de la aplicación" Style="{StaticResource BtMuted}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding TemaOscuro}" VerticalOptions="Center"
                                OnColor="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}"
                                SemanticProperties.Description="Activar tema oscuro" />
                    </Grid>
                </Border>

                <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="Transparent" BorderWidth="1" CornerRadius="14" HeightRequest="50"
                        BorderColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                        TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
            </VerticalStackLayout>
        </ScrollView>
    </controls:StateView>
</ContentPage>
