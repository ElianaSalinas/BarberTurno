<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Style="{StaticResource M10Page}"
             Title="Perfil"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <controls:StateView State="{Binding State}" ErrorText="{Binding MensajeError}" RetryCommand="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout motion:Motion.Enter="True" Padding="24,28,24,32" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="TU CUENTA" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                    <Label Text="Perfil" Style="{StaticResource BtTitle}" />
                    <Label Text="Tu estilo, tus preferencias, siempre contigo." Style="{StaticResource BtMuted}" />
                </VerticalStackLayout>

                <!-- Tarjeta de usuario -->
                <Border Style="{StaticResource BtDarkCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <!-- Avatar o foto -->
                        <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}">
                            <Grid>
                                <Label Text="{Binding Inicial}" FontFamily="OpenSansSemibold" FontSize="26"
                                       TextColor="#1B1B17" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding FotoUrl, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="White" />
                            <Label Text="{Binding RolTexto}" FontSize="12" CharacterSpacing="1" Style="{StaticResource BtGold}" />
                        </VerticalStackLayout>

                        <!-- Botones cambiar foto: Cámara y Galería -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <Button Text="Cámara" FontSize="11" HeightRequest="36" Padding="10,0"
                                    Command="{Binding TomarFotoCommand}" Style="{StaticResource BtSecondaryButton}" />
                            <Button Text="Galería" FontSize="11" HeightRequest="36" Padding="10,0"
                                    Command="{Binding CambiarFotoCommand}" Style="{StaticResource BtGoldButton}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- SECCIÓN DE SERVICIOS PARA EL BARBERO -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding EsBarbero}">
                    <Label Text="MIS SERVICIOS OFRECIDOS" FontSize="11" CharacterSpacing="1.2" Style="{StaticResource BtGold}" />
                    
                    <!-- Lista de servicios con Checkboxes -->
                    <Border Style="{StaticResource BtCard}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Selecciona los servicios que realizas:" FontSize="13" Style="{StaticResource BtMuted}" />
                            
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MisServicios}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServicioSeleccionableItem">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="14" />
                                                <Label Text="{Binding Detalle}" FontSize="12" Style="{StaticResource BtMuted}" />
                                            </VerticalStackLayout>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Asignado}" Color="{StaticResource M10LightGold}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Button Text="Guardar servicios activos" Command="{Binding GuardarServiciosAsignadosCommand}"
                                    Style="{StaticResource BtGoldButton}" HeightRequest="44" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Crear nuevo servicio personalizado -->
                    <Border Style="{StaticResource BtCard}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Crear nuevo servicio" Style="{StaticResource BtH2}" />
                            <Label Text="¿Ofreces un corte o servicio especial? Agrégalo al catálogo:" FontSize="12" Style="{StaticResource BtMuted}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nombre del servicio" FontSize="12" FontAttributes="Bold" Style="{StaticResource BtText}" />
                                <Entry Placeholder="Ej. Corte Ejecutivo + Barba" Text="{Binding NuevoServicioNombre}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Precio (RD$)" FontSize="12" FontAttributes="Bold" Style="{StaticResource BtText}" />
                                    <Entry Placeholder="Ej. 600" Text="{Binding NuevoServicioPrecio}" Keyboard="Numeric" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Duración (minutos)" FontSize="12" FontAttributes="Bold" Style="{StaticResource BtText}" />
                                    <Picker ItemsSource="{Binding DuracionesDisponibles}"
                                            SelectedItem="{Binding DuracionSeleccionada}"
                                            Title="Seleccionar minutos" ItemDisplayBinding="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="{Binding MensajeErrorServicio}"
                                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                                   FontSize="12"
                                   IsVisible="{Binding TieneErrorServicio}" />
                            <Border HeightRequest="130" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    Background="{AppThemeBinding Light={StaticResource M10LightHighlight}, Dark={StaticResource M10DarkHighlight}}">
                                <Grid>
                                    <Label Text="Foto del resultado (opcional)" FontSize="12" Style="{StaticResource BtMuted}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding NuevoServicioFoto, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ElegirFotoServicioCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Button Text="Elegir foto del servicio" Command="{Binding ElegirFotoServicioCommand}"
                                    Style="{StaticResource BtLinkButton}" HeightRequest="36" />

                            <Button Text="+ Crear y asignar servicio" Command="{Binding CrearNuevoServicioCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#18202D, Dark=#2A2C22}" TextColor="White"
                                    CornerRadius="12" HeightRequest="44" Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Tema -->
                <Border Style="{StaticResource BtCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Tema oscuro" Style="{StaticResource BtH2}" />
                            <Label Text="Cambia la apariencia de la aplicación" Style="{StaticResource BtMuted}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding TemaOscuro}" VerticalOptions="Center"
                                OnColor="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}"
                                SemanticProperties.Description="Activar tema oscuro" />
                    </Grid>
                </Border>

                <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="Transparent" BorderWidth="1" CornerRadius="14" HeightRequest="50"
                        BorderColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                        TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
            </VerticalStackLayout>
        </ScrollView>
    </controls:StateView>
</ContentPage>
