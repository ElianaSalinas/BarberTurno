<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             x:Class="BarberTurno.Views.RegistroPage"
             x:DataType="vm:RegistroViewModel"
             Style="{StaticResource M10Page}"
             Title="Crear cuenta"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">

    <ContentPage.Resources>
        <!-- RadioButton convertido en "chip" de rol: se ilumina en dorado al seleccionarlo -->
        <ControlTemplate x:Key="RolChip">
            <Border x:Name="Caja" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="0,14"
                    Background="{AppThemeBinding Light={StaticResource M10LightSurface}, Dark={StaticResource M10DarkSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource M10LightBorder}, Dark={StaticResource M10DarkBorder}}">
                <Label x:Name="Texto" Text="{TemplateBinding Content}" HorizontalOptions="Center"
                       FontFamily="OpenSansSemibold" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource M10LightMutedText}, Dark={StaticResource M10DarkMutedText}}" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CheckedStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter TargetName="Caja" Property="Border.Background" Value="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkGold}}" />
                                    <Setter TargetName="Caja" Property="Border.Stroke" Value="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />
                                    <Setter TargetName="Texto" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource M10LightGold}, Dark=#1B1B17}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </ControlTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout motion:Motion.Enter="True" Padding="28,56,28,32" Spacing="14" MaximumWidthRequest="460">

            <Label Text="NUEVA CUENTA" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
            <Label Text="Crea tu cuenta" Style="{StaticResource BtTitle}" Margin="0,-10,0,0" />
            <Label Text="Solo toma un minuto." Style="{StaticResource BtMuted}" Margin="0,-10,0,6" />

            <Label Text="¿CÓMO TE QUIERES REGISTRAR?" FontSize="10" CharacterSpacing="1.2" Style="{StaticResource BtMuted}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,-6,0,4">
                <RadioButton x:Name="RadioCliente" Content="Cliente" GroupName="Rol"
                             ControlTemplate="{StaticResource RolChip}" IsChecked="{Binding EsCliente, Mode=TwoWay}" />
                <RadioButton x:Name="RadioBarbero" Grid.Column="1" Content="Barbero" GroupName="Rol"
                             ControlTemplate="{StaticResource RolChip}" IsChecked="{Binding EsBarbero, Mode=TwoWay}" />
            </Grid>

                        <Label Text="{Binding NombreError}" FontSize="12"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" Margin="2,0,0,-6">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding NombreError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Style="{StaticResource BtField}">
                <Entry x:Name="EntryNombre" Style="{StaticResource BtEntry}" Text="{Binding Nombre}"
                       Placeholder="Nombre completo" Keyboard="Text" ReturnType="Next" MaxLength="60" />
            </Border>

            <Label Text="{Binding TelefonoError}" FontSize="12"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" Margin="2,0,0,-6">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TelefonoError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Style="{StaticResource BtField}">
                <Entry x:Name="EntryTelefono" Style="{StaticResource BtEntry}" Text="{Binding Telefono}"
                       Placeholder="Teléfono (10 dígitos)" Keyboard="Telephone" ReturnType="Next" MaxLength="15" />
            </Border>

            <Label Text="{Binding UsuarioError}" FontSize="12"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" Margin="2,0,0,-6">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding UsuarioError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Style="{StaticResource BtField}">
                <Entry x:Name="EntryUsuario" Style="{StaticResource BtEntry}" Text="{Binding Usuario}"
                       Placeholder="Usuario" Keyboard="Email" ReturnType="Next" MaxLength="30" />
            </Border>

            <Label Text="{Binding PasswordError}" FontSize="12"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" Margin="2,0,0,-6">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding PasswordError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Style="{StaticResource BtField}">
                <Entry x:Name="EntryPassword" Style="{StaticResource BtEntry}" Text="{Binding Password}"
                       Placeholder="Contraseña (mínimo 6 caracteres)" IsPassword="True" ReturnType="Next" MaxLength="64" />
            </Border>

            <Label Text="{Binding ConfirmarPasswordError}" FontSize="12"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" Margin="2,0,0,-6">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ConfirmarPasswordError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border Style="{StaticResource BtField}">
                <Entry x:Name="EntryConfirmarPassword" Style="{StaticResource BtEntry}" Text="{Binding ConfirmarPassword}"
                       Placeholder="Confirmar contraseña" IsPassword="True" ReturnType="Done" MaxLength="64"
                       ReturnCommand="{Binding RegistrarCommand}" />
            </Border>

            <Label x:Name="LabelError" Text="{Binding MensajeError}" FontSize="13"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding MensajeError}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="Crear cuenta" Command="{Binding RegistrarCommand}" Style="{StaticResource BtGoldButton}" Margin="0,6,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />

            <Button Text="¿Ya tienes cuenta? Inicia sesión" Command="{Binding VolverALoginCommand}"
                    Style="{StaticResource BtLinkButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
