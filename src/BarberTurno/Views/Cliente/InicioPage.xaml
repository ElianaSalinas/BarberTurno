<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.InicioPage"
             x:DataType="vm:InicioViewModel"
             Style="{StaticResource M10Page}"
             Title="Inicio"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout motion:Motion.Enter="True" Padding="24,24,24,32" Spacing="20" MaximumWidthRequest="460">

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Fecha}" FontSize="11" CharacterSpacing="1.2" Style="{StaticResource BtMuted}" />
                <Label Text="{Binding Saludo}" Style="{StaticResource BtTitle}" FontSize="32" />
                <Label Text="¿Listo para verte bien?" FontFamily="OpenSansSemibold" FontSize="28"
                       TextColor="{AppThemeBinding Light={StaticResource M10LightMutedText}, Dark={StaticResource M10DarkMutedText}}" />
            </VerticalStackLayout>

            <!-- Con próximo turno -->
            <Border Style="{StaticResource BtDarkCard}" Padding="22" IsVisible="{Binding TieneProxima}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="●  TU PRÓXIMO TURNO" FontSize="10" CharacterSpacing="1.5" Style="{StaticResource BtGold}" />
                        <Label Text="{Binding ProximaFecha}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" />
                        <Label FontSize="13" TextColor="#B8B5AD">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ProximaHora}" />
                                    <Span Text="   ·   " TextColor="#D6B362" />
                                    <Span Text="{Binding ProximaServicio}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="2" Stroke="#D4AE59" BackgroundColor="Transparent">
                                <Label Text="{Binding ProximaBarberoInicial}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#D6B362" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding ProximaBarbero, StringFormat='Con {0}'}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="White" />
                                <Label Text="Barbero profesional" FontSize="10" TextColor="#918F88" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="58" HeightRequest="64" VerticalOptions="Start" StrokeShape="RoundRectangle 13" StrokeThickness="0" BackgroundColor="#E8C370">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{Binding DiaNumero}" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#292823" HorizontalOptions="Center" />
                            <Label Text="{Binding MesCorto}" FontFamily="OpenSansSemibold" FontSize="9" TextColor="#292823" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Sin turno -->
            <Border Style="{StaticResource BtDarkCard}" Padding="22">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding TieneProxima}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="10">
                    <Label Text="●  TU PRÓXIMO TURNO" FontSize="10" CharacterSpacing="1.5" Style="{StaticResource BtGold}" />
                    <Label Text="Aún no tienes turnos" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White" />
                    <Label Text="Reserva en menos de un minuto." FontSize="13" TextColor="#B8B5AD" />
                </VerticalStackLayout>
            </Border>

            <!-- Acción principal -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16"
                    Background="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ReservarCommand}" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#40FFFFFF">
                        <Label Text="+" FontSize="28" TextColor="#1B1B17" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Reservar un turno" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#1B1B17" />
                        <Label Text="Elige barbero, servicio y hora" FontSize="11" TextColor="#5A4A22" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#1B1B17" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Equipo -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TU EQUIPO" FontSize="9" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                        <Label Text="Elige a tu barbero" Style="{StaticResource BtH2}" FontSize="19" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="Ver todos" FontSize="11" VerticalOptions="End" Style="{StaticResource BtGold}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ReservarCommand}" /></Label.GestureRecognizers>
                    </Label>
                </Grid>

                <CollectionView ItemsSource="{Binding Barberos}" SelectionMode="None" HeightRequest="170">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarberoItem">
                            <VerticalStackLayout WidthRequest="104" Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border HeightRequest="118" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                        Background="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkDarkCard}}">
                                    <Grid>
                                        <Label Text="{Binding Inicial}" FontSize="34" Style="{StaticResource BtGold}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Image Source="{Binding FotoUrl, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Nombre}" Style="{StaticResource BtH2}" FontSize="13" Margin="2,6,0,0" />
                                <Label Text="{Binding ServiciosTexto}" Style="{StaticResource BtMuted}" FontSize="10" MaxLines="1" LineBreakMode="TailTruncation" Margin="2,0,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
