<?xml version="1.0" encoding="utf-8" ?>
<!-- Responsable: M09. Servicios del barbero elegido. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.ServiciosPage"
             x:DataType="vm:ServiciosViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Aviso sin conexión -->
        <Border Grid.Row="0"
                IsVisible="{Binding SinConexion}"
                StrokeThickness="0"
                Padding="16,8"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
            <Label Text="Sin conexión · mostrando datos guardados"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
        </Border>

        <Label Grid.Row="1"
               Text="{Binding Subtitulo}"
               Margin="16,16,16,0"
               FontSize="15"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

        <controls:StateView Grid.Row="2"
                            State="{Binding State}"
                            EmptyText="Este barbero todavía no tiene servicios disponibles."
                            ErrorText="{Binding MensajeError}"
                            RetryCommand="{Binding CargarCommand}">

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefrescarCommand}">
                <CollectionView ItemsSource="{Binding Servicios}"
                                SelectionMode="None"
                                Margin="0,12">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServicioItem">
                            <Border Margin="16,0"
                                    Padding="16,14"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                    SemanticProperties.Description="{Binding Nombre}"
                                    SemanticProperties.Hint="Toca para elegir la hora">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiciosViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Nombre}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="17" />
                                        <Label Text="{Binding DuracionTexto}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding PrecioTexto}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </controls:StateView>
    </Grid>
</ContentPage>
