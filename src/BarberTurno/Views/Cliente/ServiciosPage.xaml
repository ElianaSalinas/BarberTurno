<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.ServiciosPage"
             x:DataType="vm:ServiciosViewModel"
             Style="{StaticResource M10Page}"
             Title="{Binding Titulo}"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">

    <Grid motion:Motion.Enter="True" RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" IsVisible="{Binding SinConexion}" StrokeThickness="0" Padding="16,8"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
            <Label Text="Sin conexión · mostrando datos guardados" FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="24,20,24,4" Spacing="4">
            <Label Text="NUESTRO MENÚ" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
            <Label Text="Elige tu ritual" Style="{StaticResource BtTitle}" />
            <Label Text="{Binding Subtitulo}" Style="{StaticResource BtMuted}" />
        </VerticalStackLayout>

        <controls:StateView Grid.Row="2" State="{Binding State}"
                            EmptyText="Este barbero todavía no tiene servicios disponibles."
                            ErrorText="{Binding MensajeError}"
                            RetryCommand="{Binding CargarCommand}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefrescarCommand}">
                <CollectionView ItemsSource="{Binding Servicios}" SelectionMode="None" Margin="0,12">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServicioItem">
                            <Border Style="{StaticResource BtCard}" Margin="24,0"
                                    SemanticProperties.Description="{Binding Nombre}"
                                    SemanticProperties.Hint="Toca para elegir la hora">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiciosViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="12">
                                    <Border HeightRequest="140" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            Background="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkDarkCard}}">
                                        <Grid>
                                            <Image Source="icon_scissors_gold.svg" WidthRequest="34" HeightRequest="34"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.7" />
                                            <Image Source="{Binding ImagenArchivo}" Aspect="AspectFill" />
                                            <Image Source="{Binding FotoUrl, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Nombre}" Style="{StaticResource BtH2}" FontSize="17" />
                                            <Label Text="{Binding DuracionTexto}" Style="{StaticResource BtMuted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding PrecioTexto}" FontSize="18"
                                               Style="{StaticResource BtGold}" VerticalOptions="Start" />
                                    </Grid>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,10"
                                            Background="{AppThemeBinding Light={StaticResource M10LightHighlight}, Dark={StaticResource M10DarkHighlight}}">
                                        <Label Text="Reservar  ›" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource M10LightText}, Dark={StaticResource M10DarkText}}"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </controls:StateView>
    </Grid>
</ContentPage>
