<?xml version="1.0" encoding="utf-8" ?>
<!-- Responsable: M09. Lista de barberos y sus servicios (cuatro estados). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.BarberosPage"
             x:DataType="vm:BarberosViewModel"
             Title="Barberos">

    <Grid RowDefinitions="Auto,*">

        <!-- Aviso sin conexión -->
        <Border Grid.Row="0"
                IsVisible="{Binding SinConexion}"
                StrokeThickness="0"
                Padding="16,8"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
            <Label Text="Sin conexión · mostrando datos guardados"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
        </Border>

        <controls:StateView Grid.Row="1"
                            State="{Binding State}"
                            EmptyText="Aún no hay barberos disponibles."
                            ErrorText="{Binding MensajeError}"
                            RetryCommand="{Binding CargarCommand}">

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefrescarCommand}">
                <CollectionView ItemsSource="{Binding Barberos}"
                                SelectionMode="None"
                                Margin="0,12">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarberoItem">
                            <Border Margin="16,0"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                    SemanticProperties.Description="{Binding Nombre, StringFormat='Barbero {0}'}"
                                    SemanticProperties.Hint="Toca para ver sus servicios">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BarberosViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <!-- Avatar: inicial del nombre y, si existe, la foto encima -->
                                    <Border Grid.Column="0"
                                            WidthRequest="56"
                                            HeightRequest="56"
                                            StrokeShape="RoundRectangle 28"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Grid>
                                            <Label Text="{Binding Inicial}"
                                                   FontSize="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                            <Image Source="{Binding FotoUrl}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding TieneFoto}" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="18" />
                                        <Label Text="{Binding ServiciosTexto}"
                                               FontSize="13"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </controls:StateView>
    </Grid>
</ContentPage>
