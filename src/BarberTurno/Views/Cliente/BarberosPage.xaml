<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.BarberosPage"
             x:DataType="vm:BarberosViewModel"
             Style="{StaticResource M10Page}"
             Title="Barberos"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <Grid motion:Motion.Enter="True" RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" IsVisible="{Binding SinConexion}" StrokeThickness="0" Padding="16,8"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
            <Label Text="Sin conexión · mostrando datos guardados" FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="24,28,24,8" Spacing="4">
            <Label Text="TU EQUIPO" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
            <Label Text="Elige a tu barbero" Style="{StaticResource BtTitle}" />
            <Label Text="Selecciona quién te atenderá y mira sus servicios." Style="{StaticResource BtMuted}" />
        </VerticalStackLayout>

        <controls:StateView Grid.Row="2" State="{Binding State}"
                            EmptyText="Aún no hay barberos disponibles."
                            ErrorText="{Binding MensajeError}"
                            RetryCommand="{Binding CargarCommand}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefrescarCommand}">
                <CollectionView ItemsSource="{Binding Barberos}" SelectionMode="None" Margin="0,12">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarberoItem">
                            <Border Style="{StaticResource BtCard}" Margin="24,0"
                                    SemanticProperties.Description="{Binding Nombre, StringFormat='Barbero {0}'}"
                                    SemanticProperties.Hint="Toca para ver sus servicios">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BarberosViewModel}}, Path=SeleccionarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="58" HeightRequest="58"
                                            StrokeShape="RoundRectangle 18" StrokeThickness="0"
                                            Background="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkDarkCard}}">
                                        <Grid>
                                            <Label Text="{Binding Inicial}" FontSize="22" Style="{StaticResource BtGold}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding FotoUrl, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" Style="{StaticResource BtH2}" FontSize="17" />
                                        <Label Text="{Binding ServiciosTexto}" Style="{StaticResource BtMuted}"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="›" FontSize="28" VerticalOptions="Center"
                                           Style="{StaticResource BtGold}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </controls:StateView>
    </Grid>
</ContentPage>
