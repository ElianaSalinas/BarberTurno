<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.ConfirmarReservaPage"
             x:DataType="vm:ConfirmarReservaViewModel"
             Style="{StaticResource M10Page}"
             Title="Confirmar reserva">

    <controls:StateView State="{Binding State}" ErrorText="{Binding MensajeError}" RetryCommand="{Binding VolverCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,32" Spacing="16">

                <Border IsVisible="{Binding SinConexion}" StrokeThickness="0" Padding="12,8" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
                    <Label Text="Sin conexión · tu reserva se enviará cuando vuelvas a tener internet" FontSize="12"
                           HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="ÚLTIMO PASO" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                    <Label Text="Confirma tu turno" Style="{StaticResource BtTitle}" />
                    <Label Text="Revisa que todo esté bien." Style="{StaticResource BtMuted}" />
                </VerticalStackLayout>

                <!-- Resumen oscuro -->
                <Border Style="{StaticResource BtDarkCard}" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="●  TU TURNO" FontSize="10" CharacterSpacing="1.5" Style="{StaticResource BtGold}" />
                        <Label Text="{Binding FechaTexto}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White" />
                        <Label Text="{Binding HoraTexto}" FontSize="15" TextColor="#D6B362" />
                        <BoxView HeightRequest="1" Color="#45433B" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" StrokeThickness="2" Stroke="#D4AE59" BackgroundColor="Transparent">
                                <Label Text="{Binding BarberoIniciales}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#D6B362"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding BarberoNombre, StringFormat='Con {0}'}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="White" />
                                <Label Text="Barbero profesional" FontSize="11" TextColor="#918F88" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Servicio -->
                <Border Style="{StaticResource BtCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="SERVICIO" FontSize="9" CharacterSpacing="1.2" Style="{StaticResource BtMuted}" />
                            <Label Text="{Binding ServicioNombre}" Style="{StaticResource BtH2}" FontSize="17" />
                            <Label Text="{Binding DuracionTexto}" Style="{StaticResource BtMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PrecioTexto}" FontSize="19" VerticalOptions="Center" Style="{StaticResource BtGold}" />
                    </Grid>
                </Border>

                <Label Text="{Binding Progreso}" IsVisible="{Binding IsBusy}" FontSize="12" HorizontalTextAlignment="Center" Style="{StaticResource BtMuted}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"
                                   Color="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />

                <Button Text="{Binding PrecioTexto, StringFormat='Confirmar por {0}  ›'}" Command="{Binding ConfirmarCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkGold}}"
                        TextColor="{AppThemeBinding Light=White, Dark=#1B1B17}"
                        FontFamily="OpenSansSemibold" FontSize="14" CornerRadius="14" HeightRequest="54" />
                <Button Text="Cambiar hora" Command="{Binding VolverCommand}" Style="{StaticResource BtLinkButton}" />
            </VerticalStackLayout>
        </ScrollView>
    </controls:StateView>
</ContentPage>
