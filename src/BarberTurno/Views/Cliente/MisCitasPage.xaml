<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             xmlns:conv="clr-namespace:BarberTurno.Helpers.Converters"
             x:Class="BarberTurno.Views.MisCitasPage"
             x:DataType="vm:MisCitasViewModel"
             Style="{StaticResource M10Page}"
             Title="Mis citas"
             xmlns:motion="clr-namespace:BarberTurno.Helpers">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <ContentPage.Resources>
        <conv:EstadoCitaToTextoConverter x:Key="EstadoTexto" />
        <conv:EstadoCitaToColorConverter x:Key="EstadoColor" />
    </ContentPage.Resources>

    <Grid motion:Motion.Enter="True" RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" IsVisible="{Binding SinConexion}" StrokeThickness="0" Padding="16,8"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
            <Label Text="Sin conexión · mostrando datos guardados" FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="24,28,24,8" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="TU AGENDA" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                <Label Text="Mis turnos" Style="{StaticResource BtTitle}" />
                <Label Text="Todo organizado, sin chats ni esperas." Style="{StaticResource BtMuted}" />
            </VerticalStackLayout>

            <!-- Pestañas tipo segmento -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4"
                    Background="{AppThemeBinding Light=#EEEBE4, Dark={StaticResource M10DarkBorder}}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Grid.Column="0" Text="Próximas" Command="{Binding VerProximasCommand}"
                            BackgroundColor="Transparent" CornerRadius="11" FontSize="13" HeightRequest="40"
                            TextColor="{AppThemeBinding Light={StaticResource M10LightMutedText}, Dark={StaticResource M10DarkMutedText}}"
                            SemanticProperties.Description="Ver citas próximas">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoProximas}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource M10DarkSurface}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M10LightText}, Dark={StaticResource M10DarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Anteriores" Command="{Binding VerAnterioresCommand}"
                            BackgroundColor="Transparent" CornerRadius="11" FontSize="13" HeightRequest="40"
                            TextColor="{AppThemeBinding Light={StaticResource M10LightMutedText}, Dark={StaticResource M10DarkMutedText}}"
                            SemanticProperties.Description="Ver citas anteriores">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoProximas}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource M10DarkSurface}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M10LightText}, Dark={StaticResource M10DarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <controls:StateView Grid.Row="2" State="{Binding State}"
                            EmptyText="{Binding TextoVacio}"
                            ErrorText="{Binding MensajeError}"
                            RetryCommand="{Binding CargarCommand}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefrescarCommand}">
                <CollectionView ItemsSource="{Binding Citas}" SelectionMode="None" Margin="0,8,0,12">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CitaItem">
                            <Border Style="{StaticResource BtCard}" Margin="24,0">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding ServicioNombre}" Style="{StaticResource BtH2}"
                                               FontSize="17" VerticalOptions="Center" />
                                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="10,4"
                                                BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColor}}"
                                                SemanticProperties.Description="{Binding Estado, Converter={StaticResource EstadoTexto}, StringFormat='Estado de la cita: {0}'}">
                                            <Label Text="{Binding Estado, Converter={StaticResource EstadoTexto}}"
                                                   FontSize="11" FontFamily="OpenSansSemibold" TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding BarberoNombre, StringFormat='con {0}'}" Style="{StaticResource BtMuted}" FontSize="13" />
                                    <Label Text="{Binding FechaTexto}" FontSize="14" Style="{StaticResource BtGold}" />

                                    <Label Text="{Binding MotivoRechazo}" IsVisible="{Binding TieneMotivo}" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />

                                    <Button Text="Cancelar cita" IsVisible="{Binding PuedeCancelar}"
                                            HorizontalOptions="Start" BackgroundColor="Transparent"
                                            BorderWidth="1" CornerRadius="10" FontSize="12" HeightRequest="38"
                                            BorderColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                                            TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MisCitasViewModel}}, Path=CancelarCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </controls:StateView>
    </Grid>
</ContentPage>
