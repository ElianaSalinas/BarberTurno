<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.SeleccionHoraPage"
             x:DataType="vm:SeleccionHoraViewModel"
             Style="{StaticResource M10Page}"
             Title="Escoge la hora">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,20,24,24" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="NUEVA RESERVA" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
                <Label Text="Agenda tu turno" Style="{StaticResource BtTitle}" />
                <Label Text="{Binding Resumen}" Style="{StaticResource BtMuted}" />
            </VerticalStackLayout>

            <Label Text="{Binding Aviso}" IsVisible="{Binding HayAviso}" FontSize="12" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#78350F, Dark=#FEF3C7}" />

            <!-- Selector de día -->
            <Border Style="{StaticResource BtCard}" Padding="8">
                <Grid ColumnDefinitions="48,*,48">
                    <Button Text="‹" Command="{Binding DiaAnteriorCommand}" BackgroundColor="Transparent" FontSize="26"
                            TextColor="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}"
                            SemanticProperties.Description="Día anterior" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="FECHA" FontSize="9" CharacterSpacing="1.2" HorizontalOptions="Center" Style="{StaticResource BtMuted}" />
                        <Label Text="{Binding FechaTexto}" Style="{StaticResource BtH2}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="›" Command="{Binding DiaSiguienteCommand}" BackgroundColor="Transparent" FontSize="26"
                            TextColor="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}"
                            SemanticProperties.Description="Día siguiente" />
                </Grid>
            </Border>

            <Label Text="HORAS DISPONIBLES" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
        </VerticalStackLayout>

        <controls:StateView Grid.Row="1" State="{Binding State}"
                            EmptyText="No hay horas libres este día. Prueba con otra fecha."
                            ErrorText="{Binding MensajeError}">
            <CollectionView ItemsSource="{Binding Horas}" SelectionMode="Single"
                            SelectedItem="{Binding HoraSeleccionada}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotItem">
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="0,12"
                                Stroke="{AppThemeBinding Light={StaticResource M10LightBorder}, Dark={StaticResource M10DarkBorder}}"
                                Background="{AppThemeBinding Light={StaticResource M10LightSurface}, Dark={StaticResource M10DarkSurface}}">
                            <Label Text="{Binding HoraTexto}" FontSize="13" HorizontalOptions="Center"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource M10LightText}, Dark={StaticResource M10DarkText}}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource M10LightHighlight}, Dark={StaticResource M10DarkHighlight}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource M10LightGold}, Dark={StaticResource M10DarkGold}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </controls:StateView>

        <Button Grid.Row="2" Text="Continuar  ›" Command="{Binding ContinuarCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkGold}}"
                TextColor="{AppThemeBinding Light=White, Dark=#1B1B17}"
                FontFamily="OpenSansSemibold" FontSize="14" CornerRadius="14" HeightRequest="52" />
    </Grid>
</ContentPage>
