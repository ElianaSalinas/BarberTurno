<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             xmlns:motion="clr-namespace:BarberTurno.Helpers"
             x:Class="BarberTurno.Views.MisServiciosPage"
             x:DataType="vm:MisServiciosViewModel"
             Style="{StaticResource M10Page}"
             Title="Mis servicios">
    <Shell.TitleView><controls:BrandBar /></Shell.TitleView>

    <Grid motion:Motion.Enter="True" RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="24,28,24,8" Spacing="4">
            <Label Text="TU CATÁLOGO" FontSize="10" CharacterSpacing="1.3" Style="{StaticResource BtGold}" />
            <Label Text="Mis servicios" Style="{StaticResource BtTitle}" />
            <Label Text="Así los ven tus clientes al reservar." Style="{StaticResource BtMuted}" />
        
            <controls:EstadoBanner State="{Binding State}" ErrorText="{Binding MensajeError}" RetryCommand="{Binding CargarCommand}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Servicios}" SelectionMode="None" Margin="0,12">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Border Style="{StaticResource BtCard}" Margin="24,8" Padding="24">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Aún no tienes servicios activos" Style="{StaticResource BtH2}" HorizontalTextAlignment="Center" />
                        <Label Text="Actívalos o crea uno nuevo, con foto, desde tu Perfil." Style="{StaticResource BtMuted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServicioItem">
                    <Border Style="{StaticResource BtCard}" Margin="24,0">
                        <VerticalStackLayout Spacing="10">
                            <Border HeightRequest="150" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    Background="{AppThemeBinding Light={StaticResource M10LightDarkCard}, Dark={StaticResource M10DarkDarkCard}}">
                                <Grid>
                                    <Image Source="icon_scissors_gold.svg" WidthRequest="34" HeightRequest="34"
                                           HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.7" />
                                    <Image Source="{Binding ImagenArchivo}" Aspect="AspectFill" />
                                    <Image Source="{Binding FotoUrl, Converter={StaticResource FotoConverter}}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Nombre}" Style="{StaticResource BtH2}" FontSize="17" />
                                    <Label Text="{Binding DuracionTexto}" Style="{StaticResource BtMuted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding PrecioTexto}" FontSize="18" Style="{StaticResource BtGold}" VerticalOptions="Start" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Button Text="Agregar o editar servicios" Command="{Binding IrAPerfilCommand}"
                        Style="{StaticResource BtGoldButton}" Margin="24,16,24,32" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
