<?xml version="1.0" encoding="utf-8" ?>
<!--
    Responsable: M10.
    Pantalla: Agenda del Barbero.
    OPTIMIZADA: Sin transformaciones TranslationX que causan Layout Cycle en Windows.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             xmlns:controls="clr-namespace:BarberTurno.Controls"
             x:Class="BarberTurno.Views.AgendaDiaPage"
             x:DataType="vm:AgendaDiaViewModel"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#141412}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*"
          ColumnDefinitions="*"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <!--
            CollectionView es la lista principal de citas.

            MaximumWidthRequest:
            evita que la interfaz móvil se estire en toda una ventana de Windows.
            En teléfono no genera espacios extra; en escritorio conserva una
            proporción similar a la maqueta de Figma.

            No usamos ScrollView: CollectionView ya administra el desplazamiento.
        -->
        <CollectionView ItemsSource="{Binding CitasDelDia}"
                        SelectionMode="None"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="430">

            <VerticalStackLayout Padding="22,24,22,32"
                                 Spacing="18">

                    <!-- Marca y acción de notificaciones. -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <!--
                            Marcador temporal de la marca.
                            No se usa emoji porque cambia de apariencia entre
                            Windows, Android e iOS.
                            Se sustituirá por el SVG oficial cuando exista.
                        -->
                        <Border Background="{AppThemeBinding Light={StaticResource M10LightDarkCard},
                                                             Dark={StaticResource M10DarkDarkCard}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                HeightRequest="40"
                                WidthRequest="40">

                            <Label Text="BT"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource M10LightGold},
                                                                   Dark={StaticResource M10DarkGold}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="BarberTurno"
                               Style="{StaticResource M10BrandTitle}"
                               VerticalOptions="Center" />

                        <!--
                            Contenedor reservado para el icono oficial
                            de notificaciones. No tiene acción todavía.
                        -->
                        <Border Grid.Column="2"
                                Background="{AppThemeBinding Light={StaticResource M10LightSurface},
                                                             Dark={StaticResource M10DarkSurface}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                HeightRequest="44"
                                WidthRequest="44">

                            <Label Text="•"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource M10LightText},
                                                                   Dark={StaticResource M10DarkText}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Saludo del barbero: NombreBarbero vendrá de M06. -->
                    <VerticalStackLayout Spacing="3">

                        <Label Text="PANEL DEL BARBERO"
                               Style="{StaticResource M10Eyebrow}" />

                        <!-- Separamos las líneas para respetar el diseño móvil. -->
                        <Label Text="Buen día,"
                               Style="{StaticResource M10Greeting}" />

                    <Label Text="{Binding NombreBarbero, StringFormat='{0}.'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="32"
                           LineHeight="1.1"
                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                    <Label Text="{Binding SaludoSubtitulo}"
                           FontFamily="OpenSansRegular"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextColor="{AppThemeBinding Light=#7D786F, Dark=#A8A49A}" />
                </VerticalStackLayout>

                    <!--
                        Próxima cita.
                        ProximaCita se llena posteriormente desde ICitaRepository.
                        Mientras el repositorio no esté listo, sus campos estarán vacíos;
                        no se inventan horas, clientes ni servicios aquí.
                    -->
                    <Border Style="{StaticResource M10HeroCard}"
                            IsVisible="{Binding TieneProximaCita}">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PRÓXIMA CITA"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="1.2"
                               TextColor="{AppThemeBinding Light=#D8AD4A, Dark=#E5C168}" />

                        <Label Text="{Binding ProximaCita.Hora, StringFormat='{0} AM'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="32"
                               TextColor="#FFFFFF" />

                        <Label Text="{Binding ProximaCita.Resumen}"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="#C7C1B4" />

                        <Button Text="✓  Marcar llegada"
                                Command="{Binding VerDetalleCitaCommand}"
                                CommandParameter="{Binding ProximaCita}"
                                BackgroundColor="{AppThemeBinding Light=#E0B853, Dark=#D8AD4A}"
                                TextColor="#1C1B18"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                CornerRadius="12"
                                Padding="16,8"
                                HeightRequest="42"
                                HorizontalOptions="Start"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     3. TARJETAS DE MÉTRICAS REALES
                     ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Turnos hoy"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />

                            <Label Text="{Binding CantidadCitas}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                            <Label Text="{Binding TurnosPendientesTexto}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ingresos"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />

                            <Label Text="{Binding IngresosDelDia}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                <!-- Meta de negocio: se conectará cuando se defina. -->
                                <Label Text="{Binding MetaIngresos}"
                                       Style="{StaticResource M10Subtitle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     4. SECCIÓN: AGENDA DE HOY
                     ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="AGENDA DE HOY"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="1.2"
                               TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                        <Label Text="Tu día, de un vistazo"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                    </VerticalStackLayout>

                        <!-- Sin acción hasta que M01 defina la ruta Calendario. -->
                        <Label Grid.Column="1"
                               Text="Ver calendario"
                               Style="{StaticResource M10TextAction}"
                               VerticalOptions="End" />
                    </Grid>
                    <!--
                    Estado vacío propio de M10.

                    <VerticalStackLayout>

                        <!-- ESTADO VACÍO PROFESIONAL -->
                        <VerticalStackLayout IsVisible="{Binding EstaAgendaVacia}"
                                             Padding="28,32"
                                             Spacing="8"
                                             HorizontalOptions="Center">
                            <Label Text="📅"
                                   FontSize="32"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Tu agenda está libre"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                            <Label Text="No hay turnos registrados para hoy. Las reservas confirmadas aparecerán aquí."
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                        </VerticalStackLayout>

                <DataTemplate x:DataType="vm:CitaAgendaItem">

                    <Border Style="{StaticResource M10AgendaRow}"
                            Margin="24,0,24,10">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaDiaViewModel}}, Path=VerDetalleCitaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding EsDestacada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FBF4E9, Dark=#2B2820}" />
                                            </DataTrigger>
                                        </Grid.Triggers>

                                        <!-- Columna 0: Horario -->
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="0"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Hora}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                                            <Label Text="{Binding Periodo}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="10"
                                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                        </VerticalStackLayout>

                                        <!-- Columna 1: Línea continua con anillo dorado -->
                                        <Grid Grid.Column="1"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Fill">
                                            <BoxView WidthRequest="1"
                                                     Color="{AppThemeBinding Light=#EAE4D8, Dark=#33312B}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Fill" />

                                            <Ellipse WidthRequest="8"
                                                     HeightRequest="8"
                                                     StrokeThickness="2"
                                                     Stroke="{AppThemeBinding Light=#C9A24D, Dark=#D8AD4A}"
                                                     Fill="{AppThemeBinding Light=#FFFFFF, Dark=#1E1D19}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Columna 2: Avatar + Cliente + Servicio -->
                                        <Grid Grid.Column="2"
                                              ColumnDefinitions="42,*"
                                              ColumnSpacing="12"
                                              VerticalOptions="Center"
                                              Margin="6,0,0,0">

                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    Background="{AppThemeBinding Light=#ECE6DC, Dark=#33312B}"
                                                    HeightRequest="42"
                                                    WidthRequest="42"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding InicialesCliente}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#5C574F, Dark=#BDB7AA}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding NombreCliente}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                                <Label Text="{Binding ServicioConDuracion}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Columna 3: Chevron > -->
                                        <Label Grid.Column="3"
                                               Text="›"
                                               FontSize="22"
                                               TextColor="{AppThemeBinding Light=#A8A49A, Dark=#66635C}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
