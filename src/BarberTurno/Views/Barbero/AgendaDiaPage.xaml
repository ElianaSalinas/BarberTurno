<?xml version="1.0" encoding="utf-8" ?>
<!--
    Responsable: M10.
    Pantalla: Agenda del Barbero.
    
    COMPORTAMIENTO:
    - Cero datos simulados.
    - Si no hay citas, oculta la tarjeta Hero y muestra el estado vacío elegante.
    - ScrollView nativo fluido para Windows, Android e iOS.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             x:Class="BarberTurno.Views.AgendaDiaPage"
             x:DataType="vm:AgendaDiaViewModel"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#141412}"
             Shell.NavBarIsVisible="False">

    <!-- Grid principal con 1 fila y 1 columna para asegurar que el ScrollView reciba dimensiones finitas -->
    <Grid RowDefinitions="*"
          ColumnDefinitions="*"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Default"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="430">

            <VerticalStackLayout Padding="22,24,22,32"
                                 Spacing="18">

                <!-- ═══════════════════════════════════════════════════════
                     1. ENCABEZADO Y SALUDO DEL BARBERO
                     ═══════════════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="2">

                    <Label Text="PANEL DEL BARBERO"
                           FontFamily="OpenSansSemibold"
                           FontSize="11"
                           CharacterSpacing="1.2"
                           TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                    <Label Text="Buen día,"
                           FontFamily="OpenSansSemibold"
                           FontSize="32"
                           LineHeight="1.1"
                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                    <Label Text="{Binding NombreBarbero, StringFormat='{0}.'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="32"
                           LineHeight="1.1"
                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                    <!-- Subtítulo con cantidad real de citas -->
                    <Label Text="{Binding SaludoSubtitulo}"
                           FontFamily="OpenSansRegular"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextColor="{AppThemeBinding Light=#7D786F, Dark=#A8A49A}" />
                </VerticalStackLayout>

                <!-- ═══════════════════════════════════════════════════════
                     2. TARJETA HERO: PRÓXIMA CITA
                     (Solo se muestra si realmente existe una cita activa)
                     ═══════════════════════════════════════════════════════ -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Background="{AppThemeBinding Light=#25231F, Dark=#1E1D19}"
                        Padding="22,20"
                        IsVisible="{Binding TieneProximaCita}">

                    <Grid>
                        <!-- Aros dorados decorativos de fondo -->
                        <Ellipse WidthRequest="180"
                                 HeightRequest="180"
                                 StrokeThickness="1"
                                 Stroke="{AppThemeBinding Light=#38342A, Dark=#2E2A22}"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 TranslationX="40" />

                        <Ellipse WidthRequest="110"
                                 HeightRequest="110"
                                 StrokeThickness="1"
                                 Stroke="{AppThemeBinding Light=#443E30, Dark=#383226}"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 TranslationX="20" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="PRÓXIMA CITA"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   CharacterSpacing="1.2"
                                   TextColor="{AppThemeBinding Light=#D8AD4A, Dark=#E5C168}" />

                            <Label Text="{Binding ProximaCita.Hora, StringFormat='{0} AM'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="32"
                                   TextColor="#FFFFFF" />

                            <Label Text="{Binding ProximaCita.Resumen}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="#C7C1B4" />

                            <Button Text="✓  Marcar llegada"
                                    Command="{Binding VerDetalleCitaCommand}"
                                    CommandParameter="{Binding ProximaCita}"
                                    BackgroundColor="{AppThemeBinding Light=#E0B853, Dark=#D8AD4A}"
                                    TextColor="#1C1B18"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    CornerRadius="12"
                                    Padding="16,8"
                                    HeightRequest="42"
                                    HorizontalOptions="Start"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     3. TARJETAS DE MÉTRICAS REALES
                     ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!-- Tarjeta 1: Turnos hoy -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Turnos hoy"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />

                            <Label Text="{Binding CantidadCitas}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                            <Label Text="{Binding TurnosPendientesTexto}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjeta 2: Ingresos acumulados -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ingresos"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />

                            <Label Text="{Binding IngresosDelDia}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                            <Label Text="{Binding MetaIngresos}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     4. SECCIÓN: AGENDA DE HOY
                     ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="AGENDA DE HOY"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               CharacterSpacing="1.2"
                               TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                        <Label Text="Tu día, de un vistazo"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="6"
                                           VerticalOptions="End">
                        <Label Text="🗓"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Text="Ver calendario"
                               FontFamily="OpenSansSemibold"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     5. CONTENEDOR DE CITAS O ESTADO VACÍO
                     ═══════════════════════════════════════════════════════ -->
                <Border StrokeShape="RoundRectangle 22"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E1D19}"
                        Padding="0">

                    <VerticalStackLayout>

                        <!-- ESTADO VACÍO PROFESIONAL (Se muestra si no hay citas registradas) -->
                        <VerticalStackLayout IsVisible="{Binding EstaAgendaVacia}"
                                             Padding="28,32"
                                             Spacing="8"
                                             HorizontalOptions="Center">
                            <Label Text="📅"
                                   FontSize="32"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Tu agenda está libre"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                            <Label Text="No hay turnos registrados para hoy. Las reservas confirmadas aparecerán aquí."
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                        </VerticalStackLayout>

                        <!-- LISTA DE FILAS DE CITAS REALES -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CitasDelDia}"
                                             IsVisible="{Binding EstaAgendaVacia, Converter={StaticResource BoolInvertido}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CitaAgendaItem">
                                    <Grid Padding="16,14"
                                          ColumnDefinitions="52,24,*,18"
                                          RowDefinitions="Auto">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgendaDiaViewModel}}, Path=VerDetalleCitaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding EsDestacada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FBF4E9, Dark=#2B2820}" />
                                            </DataTrigger>
                                        </Grid.Triggers>

                                        <!-- Columna 0: Horario -->
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="0"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Hora}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                                            <Label Text="{Binding Periodo}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="10"
                                                   TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                        </VerticalStackLayout>

                                        <!-- Columna 1: Línea continua con anillo dorado -->
                                        <Grid Grid.Column="1"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Fill">
                                            <BoxView WidthRequest="1"
                                                     Color="{AppThemeBinding Light=#EAE4D8, Dark=#33312B}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Fill" />

                                            <Ellipse WidthRequest="8"
                                                     HeightRequest="8"
                                                     StrokeThickness="2"
                                                     Stroke="{AppThemeBinding Light=#C9A24D, Dark=#D8AD4A}"
                                                     Fill="{AppThemeBinding Light=#FFFFFF, Dark=#1E1D19}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Columna 2: Avatar + Cliente + Servicio -->
                                        <Grid Grid.Column="2"
                                              ColumnDefinitions="42,*"
                                              ColumnSpacing="12"
                                              VerticalOptions="Center"
                                              Margin="6,0,0,0">

                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    Background="{AppThemeBinding Light=#ECE6DC, Dark=#33312B}"
                                                    HeightRequest="42"
                                                    WidthRequest="42"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding InicialesCliente}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#5C574F, Dark=#BDB7AA}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding NombreCliente}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                                <Label Text="{Binding ServicioConDuracion}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Columna 3: Chevron > -->
                                        <Label Grid.Column="3"
                                               Text="›"
                                               FontSize="22"
                                               TextColor="{AppThemeBinding Light=#A8A49A, Dark=#66635C}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>