<?xml version="1.0" encoding="utf-8" ?>
<!--
    Responsable: M10.
    Pantalla: Detalle de Cita del Barbero.
    
    ¿QUÉ HACE ESTA VISTA?
    - Presenta la información completa de la reserva seleccionada desde la agenda.
    - Muestra los datos del cliente (nombre, avatar con iniciales y teléfono).
    - Muestra el estado actual de la cita con su color dinámico oficial (EstadoCitaToColor).
    - Proporciona botones de acción para marcar la cita como "Atendida" o "Ausente".
    - Permite acceder al historial de visitas del cliente.
    - Respeta el diseño moderno urbano con compatibilidad total con tema claro/oscuro.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BarberTurno.ViewModels"
             x:Class="BarberTurno.Views.DetalleCitaPage"
             x:DataType="vm:DetalleCitaViewModel"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#141412}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*"
          ColumnDefinitions="*"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <ScrollView VerticalScrollBarVisibility="Default"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="430">

            <VerticalStackLayout Padding="22,24,22,32"
                                 Spacing="18">

                <!-- ═══════════════════════════════════════════════════════
                     1. BARRA SUPERIOR DE NAVEGACIÓN Y TÍTULO
                     ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      VerticalOptions="Center">

                    <!-- Botón de regreso (<) -->
                    <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            StrokeShape="RoundRectangle 14"
                            HeightRequest="40"
                            WidthRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VolverCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="‹"
                               FontSize="26"
                               TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,-2,0,0" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="Detalle de la cita"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                    <!-- Espacio compensador a la derecha -->
                    <BoxView Grid.Column="2"
                             WidthRequest="40"
                             Color="Transparent" />
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     2. ESTADO VACÍO (Si la página se abre sin cita válida)
                     ═══════════════════════════════════════════════════════ -->
                <Border StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                        Padding="24"
                        IsVisible="{Binding TieneCitaSeleccionada, Converter={StaticResource BoolInvertido}}">
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label Text="🔍"
                               FontSize="32"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Selecciona una cita"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />
                        <Label Text="Abre una reserva desde tu agenda para ver la información detallada."
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     3. CONTENIDO PRINCIPAL DE LA CITA
                     (Visible únicamente cuando TieneCitaSeleccionada es True)
                     ═══════════════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding TieneCitaSeleccionada}">

                    <!-- TARJETA DEL CLIENTE -->
                    <Border StrokeShape="RoundRectangle 20"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="18,16">

                        <Grid ColumnDefinitions="52,*,Auto"
                              ColumnSpacing="14"
                              VerticalOptions="Center">

                            <!-- Avatar con iniciales del cliente -->
                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light=#ECE6DC, Dark=#33312B}"
                                    HeightRequest="52"
                                    WidthRequest="52"
                                    VerticalOptions="Center">
                                <Label Text="{Binding InicialesCliente}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#5C574F, Dark=#BDB7AA}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Nombre y teléfono del cliente -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="CLIENTE"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="10"
                                       CharacterSpacing="1.1"
                                       TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                                <Label Text="{Binding NombreCliente}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                <Label Text="{Binding TelefonoCliente}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                            </VerticalStackLayout>

                            <!-- Botón para ver historial del cliente -->
                            <Button Grid.Column="2"
                                    Text="Historial"
                                    Command="{Binding VerHistorialClienteCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#FAF5EB, Dark=#2B2820}"
                                    TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    HeightRequest="34"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- TARJETA DE FECHA, HORA Y ESTADO -->
                    <Border StrokeShape="RoundRectangle 20"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1E1A}"
                            Padding="20,18">

                        <VerticalStackLayout Spacing="14">

                            <!-- Horario y Badge de estado -->
                            <Grid ColumnDefinitions="*,Auto"
                                  VerticalOptions="Center">

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="HORARIO PROGRAMADO"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10"
                                           CharacterSpacing="1.1"
                                           TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                                    <Label Text="{Binding HoraCita}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                    <Label Text="{Binding FechaCita}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                </VerticalStackLayout>

                                <!-- Badge redondeado con el color oficial del estado (EstadoCitaToColor) -->
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{Binding EstadoCita, Converter={StaticResource EstadoCitaToColor}}"
                                        Padding="12,6"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding EstadoCitaTexto}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           TextColor="#FFFFFF" />
                                </Border>
                            </Grid>

                            <!-- Línea divisoria tenue -->
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light=#ECE6DC, Dark=#2C2B26}" />

                            <!-- SERVICIO Y PRECIO -->
                            <Grid ColumnDefinitions="*,Auto"
                                  VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="SERVICIO"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10"
                                           CharacterSpacing="1.1"
                                           TextColor="{AppThemeBinding Light=#A37E2C, Dark=#D8AD4A}" />

                                    <Label Text="{Binding NombreServicio}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}" />

                                    <Label Text="{Binding DuracionServicio}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#8A857C, Dark=#9C988F}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding PrecioServicio}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22"
                                       TextColor="{AppThemeBinding Light=#1C1B18, Dark=#F7F5F0}"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════
                         4. BOTONES DE ACCIÓN DEL BARBERO
                         ═══════════════════════════════════════════════════════ -->
                    <VerticalStackLayout Spacing="10"
                                         Margin="0,8,0,0"
                                         IsVisible="{Binding PuedeModificarEstado}">

                        <!-- Botón principal: Marcar como Atendida -->
                        <Button Text="✓  Marcar como Atendida"
                                Command="{Binding MarcarAtendidaCommand}"
                                BackgroundColor="{AppThemeBinding Light=#E0B853, Dark=#D8AD4A}"
                                TextColor="#1C1B18"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                CornerRadius="14"
                                HeightRequest="50" />

                        <!-- Botón secundario: Marcar como Ausente -->
                        <Button Text="✕  Marcar como Ausente"
                                Command="{Binding MarcarAusenteCommand}"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light=#D4CDC3, Dark=#3B3931}"
                                BorderWidth="1"
                                TextColor="{AppThemeBinding Light=#7D786F, Dark=#A8A49A}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                CornerRadius="14"
                                HeightRequest="46" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>