<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarberTurno.Views.AnimatedSplashPage"
             BackgroundColor="#1B1B17">
    <Grid RowDefinitions="*,Auto,*" RowSpacing="20">
        <Image x:Name="IconImage" Grid.Row="1"
               Source="splash_logo.svg"
               WidthRequest="128" HeightRequest="128"
               HorizontalOptions="Center"
               Opacity="0" Scale="0.85" />
        <Label x:Name="TitleLabel" Grid.Row="2"
               Text="BarberTurno"
               TextColor="#D6B362" FontSize="26" FontFamily="OpenSansSemibold"
               HorizontalOptions="Center" VerticalOptions="Start"
               Margin="0,20,0,0"
               Opacity="0" />
    </Grid>
</ContentPage>